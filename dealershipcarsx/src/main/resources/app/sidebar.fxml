<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="800.0" prefWidth="220.0" spacing="10.0" style="-fx-background-color: #1E293B;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.SidebarController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label lineSpacing="2.0" text="Torque and Tread Dealership" textFill="#F8FAFC" wrapText="true">
        <font>
            <Font name="Arial Rounded MT Bold" size="15.0" />
        </font>
        <VBox.margin>
            <Insets bottom="20.0" left="6.0" right="6.0" top="10.0" />
        </VBox.margin>
    </Label>

    <Button fx:id="inventoryBtn" maxWidth="1.7976931348623157E308" onAction="#handleNavigateDashboard" style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15; -fx-cursor: hand; -fx-font-size: 14px;" text="Inventory Dashboard" />

    <Button fx:id="transactionsBtn" maxWidth="1.7976931348623157E308" onAction="#handleNavigateTransactions" style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15; -fx-cursor: hand; -fx-font-size: 14px;" text="Sales &amp; Transactions" />

    <Button fx:id="logoutBtn" maxWidth="1.7976931348623157E308" onAction="#handleLogout" style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15; -fx-cursor: hand; -fx-font-size: 14px;" text="Log Out" />

    <VBox alignment="BOTTOM_CENTER" spacing="8.0" VBox.vgrow="ALWAYS">
        <ImageView fx:id="logoImageView" fitHeight="140.0" fitWidth="170.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@logo.png" />
            </image>
        </ImageView>
        <Label text="OFFICIAL DEALERSHIP" textFill="#64748B">
            <font>
                <Font name="System Bold" size="10.0" />
            </font>
        </Label>
    </VBox>
</VBox>