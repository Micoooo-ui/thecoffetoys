<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="800.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.DashboardController">
    <left>
        <fx:include source="sidebar.fxml" />
    </left>

    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>

            <Label text="Inventory Dashboard">
                <font>
                    <Font name="System Bold" size="24.0" />
                </font>
            </Label>

            <!-- Summary Cards -->
            <HBox spacing="16.0">
                <VBox spacing="6.0" style="-fx-background-color: white; -fx-padding: 16; -fx-background-radius: 8;" HBox.hgrow="ALWAYS">
                    <Label text="Total Vehicles" textFill="#64748B" />
                    <Label fx:id="totalVehiclesLabel" text="0">
                        <font>
                            <Font name="System Bold" size="22.0" />
                        </font>
                    </Label>
                </VBox>

                <VBox spacing="6.0" style="-fx-background-color: white; -fx-padding: 16; -fx-background-radius: 8;" HBox.hgrow="ALWAYS">
                    <Label text="Available Stock" textFill="#64748B" />
                    <Label fx:id="availableStockLabel" text="0">
                        <font>
                            <Font name="System Bold" size="22.0" />
                        </font>
                    </Label>
                </VBox>

                <VBox spacing="6.0" style="-fx-background-color: white; -fx-padding: 16; -fx-background-radius: 8;" HBox.hgrow="ALWAYS">
                    <Label text="Sold / Reserved" textFill="#64748B" />
                    <Label fx:id="soldReservedLabel" text="0">
                        <font>
                            <Font name="System Bold" size="22.0" />
                        </font>
                    </Label>
                </VBox>
            </HBox>

            <!-- Filter, Search & Actions -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <TextField fx:id="searchField" prefWidth="220.0" promptText="Search vehicles..." />
                <ComboBox fx:id="statusFilterCombo" prefWidth="140.0" />
                <Button onAction="#handleResetFilters" text="Reset" />
                <HBox alignment="CENTER_RIGHT" spacing="10.0" HBox.hgrow="ALWAYS">
                    <Button onAction="#openAddVehicleModal" text="+ Add Vehicle" />
                    <Button onAction="#handleEditVehicle" text="Edit" />
                    <Button onAction="#handleMarkAsReserved" text="Mark as Reserved" />
                    <Button onAction="#handleMarkAsSold" text="Mark as Sold" />
                    <Button onAction="#handleDeleteVehicle" text="Delete" />
                </HBox>
            </HBox>

            <!-- Vehicle Table -->
            <TableView fx:id="vehicleTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="brandColumn" minWidth="150.0" text="Brand" />
                    <TableColumn fx:id="modelColumn" minWidth="150.0" text="Model" />
                    <TableColumn fx:id="nameColumn" minWidth="150.0" text="Variant / Name" />
                    <TableColumn fx:id="yearColumn" minWidth="150.0" text="Year" />
                    <TableColumn fx:id="priceColumn" minWidth="150.0" text="SRP Price" />
                    <TableColumn fx:id="statusColumn" minWidth="150.0" text="Status" />
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>