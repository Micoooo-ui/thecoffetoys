<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="1220.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.DashboardController">
    <left>
        <fx:include source="sidebar.fxml" />
    </left>
    <center>
        <VBox prefHeight="800.0" prefWidth="1000.0" style="-fx-background-color: #F8FAFC;">
            <children>
                <!-- Centered Top Dashboard Label -->
                <Label alignment="CENTER" contentDisplay="CENTER" maxWidth="Infinity" text="Dashboard" textFill="#1e293b">
                    <font>
                        <Font name="Arial Rounded MT Bold" size="24.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="5.0" left="50.0" right="50.0" top="25.0" />
                    </VBox.margin>
                </Label>

                <HBox prefHeight="249.0" prefWidth="800.0" spacing="15.0">
                    <VBox.margin>
                        <Insets bottom="-200.0" left="50.0" right="50.0" top="15.0" />
                    </VBox.margin>
                    <children>
                        <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="15.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);" HBox.hgrow="ALWAYS">
                            <HBox.margin>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </HBox.margin>
                            <padding>
                                <Insets bottom="10.0" left="80.0" right="80.0" top="10.0" />
                            </padding>
                            <children>
                                <Label fx:id="totalVehiclesLabel" alignment="CENTER" contentDisplay="CENTER" prefHeight="56.0" prefWidth="70.0" text="0" textFill="#1e293b">
                                    <font>
                                        <Font size="35.0" />
                                    </font>
                                    <VBox.margin>
                                        <Insets bottom="-40.0" top="10.0" />
                                    </VBox.margin>
                                </Label>
                                <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="34.0" prefWidth="160.0" text="TOTAL VEHICLES">
                                    <VBox.margin>
                                        <Insets bottom="30.0" left="-40.0" right="-40.0" top="20.0" />
                                    </VBox.margin>
                                    <font>
                                        <Font size="15.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                        <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="15.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);" HBox.hgrow="ALWAYS">
                            <HBox.margin>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </HBox.margin>
                            <padding>
                                <Insets bottom="10.0" left="80.0" right="80.0" top="10.0" />
                            </padding>
                            <children>
                                <Label fx:id="availableStockLabel" alignment="CENTER" contentDisplay="CENTER" prefHeight="56.0" prefWidth="70.0" text="0" textFill="#1e293b">
                                    <font>
                                        <Font size="35.0" />
                                    </font>
                                    <VBox.margin>
                                        <Insets bottom="-40.0" top="10.0" />
                                    </VBox.margin>
                                </Label>
                                <Label alignment="CENTER" contentDisplay="CENTER" text="Available In Stock">
                                    <VBox.margin>
                                        <Insets bottom="30.0" left="-40.0" right="-40.0" top="20.0" />
                                    </VBox.margin>
                                    <font>
                                        <Font size="15.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                        <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="15.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);" HBox.hgrow="ALWAYS">
                            <HBox.margin>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </HBox.margin>
                            <padding>
                                <Insets bottom="10.0" left="80.0" right="80.0" top="10.0" />
                            </padding>
                            <children>
                                <Label fx:id="soldReservedLabel" alignment="CENTER" contentDisplay="CENTER" prefHeight="56.0" prefWidth="70.0" text="0" textFill="#1e293b">
                                    <font>
                                        <Font size="35.0" />
                                    </font>
                                    <VBox.margin>
                                        <Insets bottom="-40.0" top="10.0" />
                                    </VBox.margin>
                                </Label>
                                <Label alignment="CENTER" contentDisplay="CENTER" text="Sold / Reserved">
                                    <VBox.margin>
                                        <Insets bottom="30.0" left="-40.0" right="-40.0" top="20.0" />
                                    </VBox.margin>
                                    <font>
                                        <Font size="15.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </HBox>
                <HBox prefHeight="42.0" prefWidth="800.0">
                    <children>
                        <ComboBox fx:id="statusFilterCombo" editable="false" prefHeight="25.0" prefWidth="186.0" promptText="All Status" visibleRowCount="4" />
                        <TextField fx:id="searchField" prefHeight="25.0" prefWidth="178.0" promptText="Search by brand or model">
                            <HBox.margin>
                                <Insets left="20.0" right="15.0" />
                            </HBox.margin>
                        </TextField>
                        <Pane prefHeight="25.0" prefWidth="30.0" />
                        <Button mnemonicParsing="false" onAction="#openAddVehicleModal" prefHeight="25.0" prefWidth="105.0" style="-fx-background-color: #1E293B; -fx-text-fill: #ffffff; -fx-background-radius: 6px; -fx-cursor: hand;" text="ADD VEHICLE">
                            <HBox.margin>
                                <Insets left="1.0" right="8.0" />
                            </HBox.margin>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#handleMarkAsSold" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #059669; -fx-background-radius: 6px; -fx-text-fill: white; -fx-cursor: hand;" text="SOLD">
                            <HBox.margin>
                                <Insets left="1.0" right="8.0" />
                            </HBox.margin>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#handleEditVehicle" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color: transparent; -fx-border-color: #CBD5E1; -fx-background-radius: 6px; -fx-text-fill: #334155; -fx-cursor: hand;" text="EDIT">
                            <HBox.margin>
                                <Insets left="1.0" right="8.0" />
                            </HBox.margin>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#handleDeleteVehicle" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color: transparent; -fx-border-color: #CBD5E1; -fx-background-radius: 6px; -fx-text-fill: #334155; -fx-cursor: hand;" text="DELETE">
                            <HBox.margin>
                                <Insets left="1.0" right="8.0" />
                            </HBox.margin>
                        </Button>
                    </children>
                    <VBox.margin>
                        <Insets bottom="-320.0" left="50.0" right="50.0" top="230.0" />
                    </VBox.margin>
                </HBox>
                <TableView fx:id="vehicleTable" prefHeight="328.0" prefWidth="800.0" style="-fx-background-color: #ffffff; -fx-border-color: #E2E8F0; -fx-background-radius: 8px; -fx-border-radius: 8px;">
                    <columns>
                        <TableColumn fx:id="brandColumn" minWidth="150.0" prefWidth="120.0" text="Brand" />
                        <TableColumn fx:id="modelColumn" minWidth="150.0" prefWidth="120.0" text="Model" />
                        <TableColumn fx:id="nameColumn" minWidth="150.0" prefWidth="120.0" text="Name" />
                        <TableColumn fx:id="yearColumn" minWidth="150.0" prefWidth="80.0" text="Year" />
                        <TableColumn fx:id="priceColumn" minWidth="150.0" prefWidth="120.0" text="Price" />
                        <TableColumn fx:id="statusColumn" minWidth="150.0" prefWidth="100.0" text="Status" />
                    </columns>
                    <VBox.margin>
                        <Insets bottom="50.0" left="50.0" right="50.0" top="340.0" />
                    </VBox.margin>
                </TableView>
            </children>
        </VBox>
    </center>
</BorderPane>
