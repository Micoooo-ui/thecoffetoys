<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="1220.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.TransactionController">
    <left>
        <fx:include source="sidebar.fxml" />
    </left>
    <center>
        <VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="1000.0" spacing="15.0" style="-fx-background-color: #F1F5F9;">
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="20.0" />
            </padding>
            <children>
                <Label alignment="CENTER" contentDisplay="CENTER" maxWidth="Infinity" text="Sales and Transaction" textFill="#1e293b">
                    <font>
                        <Font name="Arial Rounded MT Bold" size="24.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
                    </VBox.margin>
                </Label>

                <HBox prefHeight="172.0" prefWidth="950.0" spacing="15.0">
                    <children>
                        <VBox alignment="CENTER" prefHeight="95.0" prefWidth="350.0" spacing="5.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
                            <HBox.margin>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </HBox.margin>
                            <children>
                                <Label prefWidth="120.0" style="-fx-text-fill: #64748B;" text="TOTAL REVENUE">
                                    <font>
                                        <Font name="Arial Rounded MT Bold" size="11.0" />
                                    </font>
                                </Label>
                                <Label fx:id="totalRevenueLabel" style="-fx-text-fill: #0F172A;" text="₱0.00">
                                    <font>
                                        <Font name="Britannic Bold" size="22.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                        <VBox alignment="CENTER" prefHeight="95.0" prefWidth="350.0" spacing="5.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
                            <HBox.margin>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </HBox.margin>
                            <children>
                                <Label prefHeight="14.0" prefWidth="130.0" style="-fx-text-fill: #64748B;" text="COMPLETED SALES">
                                    <font>
                                        <Font name="Arial Rounded MT Bold" size="11.0" />
                                    </font>
                                </Label>
                                <Label fx:id="completedSalesLabel" style="-fx-text-fill: #0F172A;" text="0">
                                    <font>
                                        <Font name="Britannic Bold" size="22.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                        <VBox alignment="CENTER" prefHeight="95.0" prefWidth="350.0" spacing="5.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
                            <HBox.margin>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </HBox.margin>
                            <children>
                                <Label prefHeight="14.0" prefWidth="130.0" style="-fx-text-fill: #64748B;" text="ACTIVE PURCHASES">
                                    <font>
                                        <Font name="Arial Rounded MT Bold" size="11.0" />
                                    </font>
                                </Label>
                                <Label fx:id="activePurchasesLabel" style="-fx-text-fill: #0F172A;" text="0">
                                    <font>
                                        <Font name="Britannic Bold" size="22.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" prefHeight="58.0" prefWidth="950.0" spacing="12.0">
                    <children>
                        <TextField fx:id="searchTransactionField" prefHeight="30.0" prefWidth="280.0" promptText="Search transactions..." style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-background-radius: 5; -fx-border-radius: 5;" />
                        <Pane prefHeight="58.0" prefWidth="80.0" HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="transactionFilterCombo" prefHeight="30.0" prefWidth="200.0" promptText="Filter by Type: All" />
                    </children>
                </HBox>
                <TableView fx:id="transactionTable" prefHeight="368.0" prefWidth="950.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="idColumn" minWidth="150.0" prefWidth="130.0" text="Trans ID" />
                        <TableColumn fx:id="vehicleColumn" minWidth="150.0" prefWidth="190.0" text="Vehicle Brand/Model" />
                        <TableColumn fx:id="customerColumn" minWidth="150.0" prefWidth="170.0" text="Client Name" />
                        <TableColumn fx:id="typeColumn" minWidth="150.0" prefWidth="110.0" text="Type" />
                        <TableColumn fx:id="dateColumn" minWidth="150.0" prefWidth="120.0" text="Date" />
                        <TableColumn fx:id="amountColumn" minWidth="150.0" prefWidth="130.0" text="Amount" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </center>
</BorderPane>
